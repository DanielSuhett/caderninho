{
  "version": 1,
  "language": "pt-BR",
  "normalization": "Unicode NFKD; remover marcas combinantes; casefold; converter + no termo plus; trocar demais caracteres que não sejam letras ou números por espaço; condensar espaços.",
  "matching": "Frases inteiras contíguas, delimitadas por início/fim ou espaço no texto normalizado. Aplicar a mesma normalização aos termos e às exclusões.",
  "policy": {
    "mode": "suggest_category_only",
    "only_when_uncategorized": true,
    "preserve_original_description": true,
    "private_rules_take_precedence": true,
    "first_match_wins": true,
    "skip_refunds_when_flagged": true,
    "unknown_direction": "no_suggestion",
    "skip_any": [
      "estorno",
      "reembolso",
      "devolucao",
      "refund",
      "reversal",
      "chargeback",
      "cashback",
      "cancelamento",
