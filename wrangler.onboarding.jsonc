{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caderninho-onboarding-20261023",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/account",
      "/account/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/token",
      "/register",
      "/.well-known/*"
    ]
  },
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caderninho-onboarding-20261023",
      "database_id": "48769c2e-9913-4cd4-a83e-cd5c80a72d41",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b5556ede7c974b089dc6041967067c62"
    }
  ],
  "workflows": [
    {
      "name": "caderninho-onboarding-20261023-finance",
      "binding": "FINANCE",
      "class_name": "FinanceWorkflow"
    },
    {
      "name": "caderninho-onboarding-20261023-rules",
      "binding": "RULES",
      "class_name": "RulesWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
