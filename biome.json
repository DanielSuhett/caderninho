{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!!**/dist",
      "!!**/.wrangler",
      "!!.agents",
      "!**/*.md",
      "!**/package-lock.json",
      "!src/worker/runtime.d.ts",
      "!!src/worker/vendor"
    ]
  },
  "formatter": {
    "attributePosition": "multiline",
    "expand": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/**", "#*/**"],
                "message": "Use caminhos relativos para os modulos locais."
              },
              {
                "group": [
                  "./**/*.ts",
                  "./**/*.tsx",
                  "../**/*.ts",
                  "../**/*.tsx"
                ],
                "message": "Omita .ts e .tsx nos imports de codigo do projeto."
              },
              {
                "group": ["./index", "../index", "./**/index", "../**/index"],
                "message": "Importe o diretorio do modulo; omita /index."
              }
            ]
          }
        },
        "noCommonJs": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useImportsFirst": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": false,
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": {
              "level": "error",
              "options": {
                "max": 4
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/__tests__/**", "tests/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off"
          },
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    },
    {
      "includes": [
        "src/worker/**/*.ts",
        "!src/worker/**/*repository.ts",
        "!src/worker/**/repository/**/*.ts",
        "!src/worker/**/entity/index.ts",
        "!src/worker/composition/index.ts",
        "!src/worker/database/index.ts",
        "!src/worker/schema/index.ts",
        "!src/worker/runtime.d.ts",
        "!src/worker/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/**", "#*/**"],
                    "message": "Use caminhos relativos para os modulos locais."
                  },
                  {
                    "group": [
                      "./**/*.ts",
                      "./**/*.tsx",
                      "../**/*.ts",
                      "../**/*.tsx"
                    ],
                    "message": "Omita .ts e .tsx nos imports de codigo do projeto."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "**/database",
                      "**/database/**",
                      "**/schema",
                      "**/schema/**",
                      "**/repository",
                      "**/repository/**",
                      "**/*.repository"
                    ],
                    "message": "SQL e D1 pertencem aos repositories; use um service e um contrato de entity."
                  },
                  {
                    "group": [
                      "./index",
                      "../index",
                      "./**/index",
                      "../**/index"
                    ],
                    "message": "Importe o diretorio do modulo; omita /index."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/worker/**/service.ts",
        "src/worker/**/*.service.ts",
        "!src/worker/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/**", "#*/**"],
                    "message": "Use caminhos relativos para os modulos locais."
                  },
                  {
                    "group": [
                      "./**/*.ts",
                      "./**/*.tsx",
                      "../**/*.ts",
                      "../**/*.tsx"
                    ],
                    "message": "Omita .ts e .tsx nos imports de codigo do projeto."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "**/database",
                      "**/database/**",
                      "**/schema",
                      "**/schema/**",
                      "**/repository",
                      "**/repository/**",
                      "**/*.repository",
                      "hono",
                      "hono/**",
                      "ky",
                      "ky/**",
                      "pluggy-sdk",
                      "pluggy-sdk/**",
                      "cloudflare:*",
                      "@cloudflare/**",
                      "**/bindings",
                      "**/bindings/**",
                      "**/composition",
                      "**/composition/**",
                      "**/controller",
                      "**/controller/**",
                      "**/*.adapter",
                      "**/http",
                      "**/http/**",
                      "**/web/**",
                      "**/pluggy/**"
                    ],
                    "message": "Services coordenam casos de uso por contratos; persistencia e transporte entram pela composicao."
                  },
                  {
                    "group": [
                      "./index",
                      "../index",
                      "./**/index",
                      "../**/index"
                    ],
                    "message": "Importe o diretorio do modulo; omita /index."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Injete uma porta de origem no service; HTTP pertence ao adapter.",
                  "D1Database": "D1 pertence ao repository.",
                  "Request": "Request pertence ao controller.",
                  "Response": "Response pertence ao controller."
                }
              }
            },
            "noRestrictedTypes": {
              "level": "error",
              "options": {
                "types": {
                  "D1Database": "D1 pertence ao repository; declare uma porta em entity.ts.",
                  "D1PreparedStatement": "Statements pertencem ao repository.",
                  "Request": "Request pertence ao controller.",
                  "Response": "Response pertence ao controller.",
                  "Bindings": "Bindings pertencem a composicao e aos adapters."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/worker/**/entity/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
