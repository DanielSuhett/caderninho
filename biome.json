    },
    {
      "includes": [
        "src/worker/**/*.ts",
        "!src/worker/**/*repository.ts",
        "!src/worker/**/repository/**/*.ts",
        "!src/worker/**/entity/index.ts",
        "!src/worker/*/controller/**/*.ts",
        "!src/worker/auth/session/index.ts",
        "!src/worker/auth/grants/index.ts",
        "!src/worker/pluggy/**",
        "!src/worker/mcp/tasks/index.ts",
        "!src/worker/sync/workflow/index.ts",
        "!src/worker/index.ts",
        "!src/worker/composition/index.ts",
        "!src/worker/bindings/index.ts",
        "!src/worker/database/index.ts",
        "!src/worker/schema/index.ts",
        "!src/worker/http/index.ts",
        "!src/worker/observability/index.ts",
        "!src/worker/runtime.d.ts",
        "!src/worker/vendor/**",
        "!src/worker/**/__tests__/**",
        "!src/worker/mcp/index.ts"
      ],
