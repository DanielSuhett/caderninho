                      "cloudflare:*",
                      "@cloudflare/**",
                      "**/bindings",
                      "**/bindings/**",
                      "**/composition",
                      "**/composition/**",
                      "**/controller",
                      "**/controller/**",
                      "**/*.adapter",
                      "**/http",
                      "**/http/**",
                      "**/web/**",
                      "**/pluggy/**",
                      "**/service",
                      "**/*.service"
                    ],
                    "message": "Repositories fazem persistencia; services coordenam os casos de uso e adapters fazem HTTP."
                  },
                  {
                    "group": [
                      "**/account",
                      "**/auth",
                      "**/finance",
                      "**/sync",
                      "**/index"
                    ],
                    "message": "Use o indice de entity para portas; os indices publicos da aplicacao expoem services."
                  },
                  {
                    "group": [
                      "./index",
                      "../index",
                      "./**/index",
                      "../**/index"
                    ],
                    "message": "Importe o diretorio do modulo; omita /index."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/domain/**/*.ts",
        "src/contracts/**/*.ts",
        "src/shared/**/*.ts",
        "!src/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/**", "#*/**"],
                    "message": "Use caminhos relativos para os modulos locais."
                  },
                  {
                    "group": [
                      "./**/*.ts",
                      "./**/*.tsx",
                      "../**/*.ts",
                      "../**/*.tsx"
                    ],
                    "message": "Omita .ts e .tsx nos imports de codigo do projeto."
                  },
                  {
                    "group": [
                      "**/worker/**",
                      "**/web/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Dominio, contratos e utilitarios nao dependem do Worker, da UI ou do banco."
                  },
                  {
                    "group": [
                      "./index",
                      "../index",
                      "./**/index",
                      "../**/index"
                    ],
                    "message": "Importe o diretorio do modulo; omita /index."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/web/**/*.ts",
        "src/web/**/*.tsx",
        "!src/web/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
