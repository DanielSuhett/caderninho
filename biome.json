{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.wrangler",
      "!!.agents",
      "!**/*.md",
      "!**/package-lock.json",
      "!src/worker/runtime.d.ts",
      "!!src/worker/vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "attributePosition": "multiline",
    "bracketSpacing": true,
    "expand": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noDuplicateEnumValues": "error",
        "noUnnecessaryConditions": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noVar": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "noCommonJs": "error",
        "useBlockStatements": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        },
        "useExportType": "error",
        "noUselessElse": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useImportsFirst": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": false,
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 20
              }
            },
            "useMaxParams": {
              "level": "error",
              "options": {
                "max": 4
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/__tests__/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off"
          }
        }
      }
    }
  ]
}
