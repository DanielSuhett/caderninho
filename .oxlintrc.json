{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    ".agents/**",
    "tools/oxlint/project/**",
    "src/worker/runtime.d.ts",
    "src/worker/vendor/**"
  ],
  "jsPlugins": [
    {
      "name": "project",
      "specifier": "./tools/oxlint/project/index.ts"
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/prefer-as-const": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "import/no-duplicates": [
      "error",
      {
        "preferInline": true
      }
    ],
    "no-duplicate-imports": [
      "error",
      {
        "includeExports": true
      }
    ],
    "import/first": "error",
    "import/newline-after-import": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/consistent-type-exports": "error"
  },
  "overrides": [
    {
      "files": ["src/domain/**/*.ts", "src/shared/**/*.ts"],
      "rules": {
        "project/no-array-filter-map": "error",
        "project/no-reduce-accumulator-copy": "error",
        "project/no-chained-type-assertions": "error",
        "project/require-readable-spacing": "error",
        "project/require-safety-comment-for-type-assertion": "error",
        "project/require-try-catch": "error"
      },
      "env": {
        "builtin": true,
        "browser": true
      }
    },
    {
      "files": ["src/shared/result.ts"],
      "rules": {
        "project/require-try-catch": "off"
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
