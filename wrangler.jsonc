{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caderninho",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/account",
      "/account/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/token",
      "/register",
      "/.well-known/*"
    ]
  },
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caderninho",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "workflows": [
    {
      "name": "caderninho-finance",
      "binding": "FINANCE",
      "class_name": "FinanceWorkflow"
    },
    {
      "name": "caderninho-rules",
      "binding": "RULES",
      "class_name": "RulesWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CLEF_ENABLED": "false"
  }
}
