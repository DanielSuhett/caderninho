{
  "name": "caderninho-runtime-test",
  "main": "runtime.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "local-test",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth" }],
  "workflows": [
    {
      "name": "test-finance",
      "binding": "FINANCE",
      "class_name": "TestWorkflow"
    },
    {
      "name": "test-rules",
      "binding": "RULES",
      "class_name": "TestRulesWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
