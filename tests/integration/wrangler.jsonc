{
  "name": "caderninho-runtime-test",
  "main": "runtime.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "local-test",
      "migrations_dir": "../../migrations",
    },
  ],
  "workflows": [
    {
      "name": "test-finance",
      "binding": "FINANCE",
      "class_name": "TestWorkflow",
    },
  ],
  "vars": { "WEBHOOK_SECRET": "synthetic-only-secret" },
}
